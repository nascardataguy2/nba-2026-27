<div id='app'><p id='app-loading'>Loading nbadfs.com&#8230;</p></div>

<div class='blog-area'>
  <b:section class='main' id='main' showaddelement='yes'>
    <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'/>
  </b:section>
</div>

<script>
//<![CDATA[
(function(){
  var BASES = [
    'https://nascardataguy2.github.io/nba-2026-27/site/',
    'https://cdn.jsdelivr.net/gh/nascardataguy2/nba-2026-27@main/site/'
  ];
  function get(file){
    var i = 0;
    function next(){
      if (i >= BASES.length) return Promise.reject(new Error('all sources failed'));
      var b = BASES[i++];
      var u = b + file + (b.indexOf('github.io') > -1 ? ('?t=' + Date.now()) : '');
      return fetch(u, {cache:'no-store'}).then(function(r){ if (!r.ok) throw new Error('bad status'); return r.text(); }).catch(next);
    }
    return next();
  }
  Promise.all([get('app.css'), get('body.html'), get('app.js')]).then(function(x){
    var s = document.createElement('style'); s.textContent = x[0]; document.head.appendChild(s);
    document.getElementById('app').innerHTML = x[1];
    var j = document.createElement('script'); j.text = x[2]; document.body.appendChild(j);
  }).catch(function(){
    document.getElementById('app').innerHTML = '<p id="app-loading">The site could not load right now. Please refresh the page in a minute.</p>';
  });
})();
//]]>
</script>
</body>
